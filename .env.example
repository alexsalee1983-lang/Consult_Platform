# 复制为 .env 后修改：cp .env.example .env
# .env 含口令，已在 .gitignore 中排除，不要提交到仓库。

# dev 开发 / test 测试机 / prod 生产。prod 下不允许测试账号、必须开启 COOKIE_SECURE，否则拒绝启动。
APP_ENV=dev
WEB_PORT=8080

# ---- 登录 ----
# 会话 Cookie 只经 HTTPS 发送。测试机用 http:// 访问时设为 false；生产必须为 true。
COOKIE_SECURE=false

# 第一个管理员：库里还没有任何用户时，启动时创建一次（之后再启动不会重复创建）。
# 创建后请删除这里的口令。也可以不配，改用命令行：
#   docker compose exec backend python -m app.cli create-user --username <名字>
# 口令至少 12 位，含大写、小写、数字、符号中的三类；TOTP 密钥为 Base32，生成方法：
#   python3 -c "import base64,secrets;print(base64.b32encode(secrets.token_bytes(20)).decode())"
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_TOTP_SECRET=

# 测试账号：只在 APP_ENV=dev/test 时创建，供 scripts/smoke_test.sh 和测试助手登录。生产环境不要配置。
# 口令和密钥自己生成，不要用示例值。
# TEST_ACCOUNT_USERNAME=
# TEST_ACCOUNT_PASSWORD=
# TEST_ACCOUNT_TOTP_SECRET=

# 数据库口令（首次启动前修改；启动后再改需要同步修改数据卷中的账号）
POSTGRES_PASSWORD=change-me-postgres

# 公司私有化部署的白名单大模型（OpenAI 兼容接口）
# 留空 = 演示模式：对话返回演示回复，其余功能正常，便于先跑通。
# 例如：LLM_BASE_URL=http://10.x.x.x:8000/v1
# 测试机没有模型时可用模拟模型：docker compose --profile mock-llm up -d --build，
#   并设 LLM_BASE_URL=http://mock-llm:8000/v1（只用于测试，生产不要启用）
LLM_BASE_URL=
LLM_API_KEY=
# 一期测试模型：公司内部离线部署的 DeepSeek V4.1 Flash；模型 ID 以模型平台接口说明为准
LLM_MODEL_REASONING=deepseek-v4.1-flash
LLM_MODEL_STANDARD=deepseek-v4.1-flash
LLM_MODEL_LIGHT=deepseek-v4.1-flash
# 超时与重试（一般不用改）
# LLM_CONNECT_TIMEOUT_SECONDS=5
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=2
# LLM_RETRY_BACKOFF_SECONDS=1
# 自动假名化：模型为公司私有化部署，默认关闭；以后接入云端模型时标准档必须开启
LLM_PSEUDONYMIZE=false

# 首次启动写入虚拟客户演示数据（BANK-A / GRID-B / MFG-C）
SEED_DEMO_DATA=true

# 国内网络构建加速（可选）
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY=https://registry.npmmirror.com
