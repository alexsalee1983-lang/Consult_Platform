# 复制为 .env 后修改：cp .env.example .env
# .env 含口令，已在 .gitignore 中排除，不要提交到仓库。

APP_ENV=dev
WEB_PORT=8080

# 数据库与对象存储口令（首次启动前修改；启动后再改需要同步修改数据卷中的账号）
POSTGRES_PASSWORD=change-me-postgres
MINIO_ACCESS_KEY=consult
MINIO_SECRET_KEY=change-me-minio-secret

# 公司私有化部署的白名单大模型（OpenAI 兼容接口）
# 留空 = 演示模式：对话返回演示回复，其余功能正常，便于先跑通。
# 例如：LLM_BASE_URL=http://10.x.x.x:8000/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_REASONING=deepseek-r1
LLM_MODEL_STANDARD=qwen2.5-72b-instruct
LLM_MODEL_LIGHT=qwen2.5-14b-instruct

# 首次启动写入虚拟客户演示数据（BANK-A / GRID-B / MFG-C）
SEED_DEMO_DATA=true

# 国内网络构建加速（可选）
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY=https://registry.npmmirror.com
