# 复制为 .env 后修改：cp .env.example .env
# .env 含口令，已在 .gitignore 中排除，不要提交到仓库。

# dev 开发 / test 测试机 / prod 生产。prod 下不允许测试账号、必须开启 COOKIE_SECURE，否则拒绝启动。
APP_ENV=dev
WEB_PORT=8080
# HTTPS（等保自查 ②a）：TLS_DIR 下放 server.crt（含中间证书）和 server.key 即启用，WEB_PORT 只做跳转；
# 生产（APP_ENV=prod）必须启用，用公司 CA 签发的证书，WEB_TLS_PORT=443，并开启 COOKIE_SECURE。
# 测试机可用 bash scripts/gen_test_cert.sh 生成自签名证书；不放证书则只用 HTTP。证书和私钥不提交。
WEB_TLS_PORT=8443
TLS_DIR=./deploy/tls
# 后端接口调试端口（只绑定 127.0.0.1）。本机 8080 / 8000 被其他服务占用时改这两个端口，
# 不需要 docker-compose.override.yml。
# BACKEND_DEBUG_PORT=8000

# ---- 登录 ----
# 会话 Cookie 只经 HTTPS 发送。测试机用 http:// 访问时设为 false；生产必须为 true。
COOKIE_SECURE=false

# 口令有效期（天，等保自查 ②d）：到期后登录只能先改口令；0 = 不限。超过 INACTIVE_ACCOUNT_DAYS 天没登录的账号在用户页标出，供管理员停用。
# PASSWORD_MAX_AGE_DAYS=180
# INACTIVE_ACCOUNT_DAYS=90

# 第一个管理员：库里还没有任何用户时，启动时创建一次（之后再启动不会重复创建）。
# 创建后请删除这里的口令。也可以不配，改用命令行：
#   docker compose exec backend python -m app.cli create-user --username <名字>
# 口令至少 12 位，含大写、小写、数字、符号中的三类；TOTP 密钥为 Base32，生成方法：
#   python3 -c "import base64,secrets;print(base64.b32encode(secrets.token_bytes(20)).decode())"
# BOOTSTRAP_ADMIN_USERNAME=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_TOTP_SECRET=

# 账号 TOTP 密钥加密存储（等保自查 ②b）：编号:base64(32 字节)。生产必须配置，否则拒绝启动；开发、测试不配置时明文存。
# 生成：python3 -c "import base64, secrets; print('k1:' + base64.b64encode(secrets.token_bytes(32)).decode())"
# 轮换：新密钥放第一位、旧密钥逗号分隔留在后面 → 重启 → python -m app.cli totp-rekey → 删掉旧密钥再重启。
# 密钥丢失则全部账号要 reset-totp，请和数据库备份分开保管。
TOTP_KEYS=

# 测试账号：只在 APP_ENV=dev/test 时创建，供 scripts/smoke_test.sh 和测试助手登录。生产环境不要配置。
# 口令和密钥自己生成，不要用示例值。
# TEST_ACCOUNT_USERNAME=
# TEST_ACCOUNT_PASSWORD=
# TEST_ACCOUNT_TOTP_SECRET=

# 数据库超级用户 consult 的口令（首次启动前修改；启动后再改需要同步修改数据卷中的账号）。
# 超级用户只用于本机运维（备份、恢复、建库建账号），后端和 worker 不用它连库。
POSTGRES_PASSWORD=change-me-postgres
# 主库应用账号 consult_app 的口令（M5 ⑧：非超级用户，后端和 worker 用它连主库）。
# 新数据卷首次启动自动建账号；已有数据卷升级时先执行一次 docker compose exec postgres app-init.sh（docs/部署手册.md）。
# 口令写进连接串，不要用 @ : / ? # % 这些符号，至少 20 位。
APP_POSTGRES_PASSWORD=change-me-app-postgres
# 知识区数据库账号 consult_kb 的口令（M5 ③ 分库：知识区单独的库 consult_kb、单独的账号，连不上主库）。
# 新数据卷首次启动自动建库建账号；已有数据卷先执行一次 docker compose exec postgres kb-init.sh，
# 再 docker compose run --rm backend python -m app.cli kb-split 把知识区数据从主库搬过去（docs/知识区分库.md）。
# 口令写进连接串，不要用 @ : / ? # % 这些符号，至少 20 位。
KB_POSTGRES_PASSWORD=change-me-kb-postgres

# 公司私有化部署的白名单大模型（OpenAI 兼容接口）
# 留空 = 演示模式：对话返回演示回复，其余功能正常，便于先跑通。
# 例如：LLM_BASE_URL=http://10.x.x.x:8000/v1
# 测试机没有模型时可用模拟模型：docker compose --profile mock-llm up -d --build，
#   并设 LLM_BASE_URL=http://mock-llm:8000/v1（只用于测试，生产不要启用）
LLM_BASE_URL=
LLM_API_KEY=
# 一期测试模型：公司内部离线部署的 DeepSeek V4.1 Flash；模型 ID 以模型平台接口说明为准
LLM_MODEL_REASONING=deepseek-v4.1-flash
LLM_MODEL_STANDARD=deepseek-v4.1-flash
LLM_MODEL_LIGHT=deepseek-v4.1-flash
# 超时与重试（一般不用改）
# LLM_CONNECT_TIMEOUT_SECONDS=5
# LLM_TIMEOUT_SECONDS=120
# LLM_MAX_RETRIES=2
# LLM_RETRY_BACKOFF_SECONDS=1
# 自动假名化：模型为公司私有化部署，默认关闭；以后接入云端模型时标准档必须开启
LLM_PSEUDONYMIZE=false
# 外部模型（公司外部的云端服务）：只允许开发和测试环境、只用虚拟客户数据（决策记录 2026-11-08）。
# 开启后严格档项目拒绝调用、强制假名化、界面提示勿输入真实客户信息；APP_ENV=prod 时开启则拒绝启动。
# 例如 DeepSeek 官方 API：
#   LLM_BASE_URL=https://api.deepseek.com
#   LLM_API_KEY=<只填在测试机 .env，不要发到聊天或提交仓库>
#   LLM_MODEL_REASONING / STANDARD / LIGHT 填平台提供的模型 ID（启动后看 /api/health 的 llm 项是否为 ok）
LLM_EXTERNAL=false

# 首次启动写入虚拟客户演示数据（BANK-A / GRID-B / MFG-C）
SEED_DEMO_DATA=true

# 国内网络构建加速（可选）
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY=https://registry.npmmirror.com
# 数据库镜像编译中文分词用的源码包（构建机连不上外网时改成公司内部镜像地址，sha256 校验不变）
# SCWS_URL=http://www.xunsearch.com/scws/down/scws-1.2.3.tar.bz2
# ZHPARSER_URL=https://github.com/amutu/zhparser/archive/refs/tags/v2.3.tar.gz

# 对象存储（MinIO，S3 接口）。三项都必须设置，docker compose 缺了会直接报错。生成方法：
#   MINIO_SECRET_KEY:     python3 -c "import secrets; print(secrets.token_urlsafe(30))"
#   MINIO_KMS_SECRET_KEY: python3 -c "import base64, secrets; print('platform-key:' + base64.b64encode(secrets.token_bytes(32)).decode())"
# KMS 主密钥用于服务端加密，丢失则数据无法解密，要与数据卷分开备份；设置后不要再改。
MINIO_ACCESS_KEY=consult-storage
MINIO_SECRET_KEY=
MINIO_KMS_SECRET_KEY=
# 构建 MinIO 镜像用（可选）：源码包和 Go 依赖的下载地址，构建机连不上外网时改成公司内部地址
# MINIO_SRC_URL=https://github.com/minio/minio/archive/refs/tags/RELEASE.2025-10-15T17-29-55Z.tar.gz
# GOPROXY=<公司内部 Go 代理地址>,direct

# 向量服务（知识检索的向量部分）。默认用 docker compose 里的 embed 服务（CPU 小型中文向量模型）；
# 公司模型平台的 embedding 接口就绪后改成它的地址和模型名，然后执行 python -m app.cli kb-reembed 重新向量化。
# 设为空（EMBED_BASE_URL=）则不启用向量检索，只用全文检索。
# EMBED_BASE_URL=http://embed:8000/v1
# EMBED_MODEL=BAAI/bge-small-zh-v1.5
# 构建 embed 镜像时下载模型用（可选）：构建机连不上外网时改成公司内部的模型镜像站
# HF_ENDPOINT=https://huggingface.co
# 检索相似度下限（可选，不写就用代码默认值）。改了要重建 backend 容器才生效；宿主机 export 的变量进不了容器。
# KB_VECTOR_MIN_SIMILARITY=0.5
# KB_BASIS_MIN_SIMILARITY=0.48

# 公开资料单人发布（决策记录 2026-11-13，默认关闭）：起步阶段人少时开启，来源为公开资料的版本可由作者本人审核发布，
# 标记“单人发布”，以后由其他知识专家补复审。项目回流的内容不适用。人够了改回 false（或删掉这行）并重建 backend 即可。
# KB_SINGLE_REVIEWER_PUBLIC=false

# 重排服务（知识检索在 RRF 融合后重新打分，决策记录 2026-11-11）。默认用 docker compose 里的 rerank 服务
# （CPU 上的 bge-reranker-v2-m3 int8 量化版）。设为空（RERANK_BASE_URL=）则不启用：只用 RRF 排序，依据查询用上面的相似度门槛。
# RERANK_BASE_URL=http://rerank:8000/v1
# 换完整版（约 2.3 GB，CPU 上慢约 3 倍）：三行一起改，然后 docker compose build rerank 并重建 rerank、backend
# RERANK_LOCAL_MODEL=BAAI/bge-reranker-v2-m3-int8   （本地 rerank 容器构建和加载的模型）
# RERANK_MODEL=BAAI/bge-reranker-v2-m3-int8         （后端请求时带的模型名）
# RERANK_IMAGE_TAG=bge-reranker-v2-m3-int8
# 外部重排服务（只限开发和测试环境、只处理虚拟客户数据，决策记录 2026-11-14；生产开启即拒绝启动）。例如硅基流动：
# RERANK_EXTERNAL=true
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_API_KEY=（只填在 .env）
# RERANK_MODEL=Qwen/Qwen3-Reranker-8B
# 换了重排模型，分数分布不同：用 kb-eval 跑评测集后调 KB_BASIS_MIN_RERANK、KB_SEARCH_MIN_RERANK。
# 送去重排的候选个数、每个候选的字数上限、依据查询和普通检索的重排分数门槛（0～1）。改了要重建 backend 容器才生效。
# KB_RERANK_CANDIDATES=10
# KB_RERANK_MAX_CHARS=300
# KB_BASIS_MIN_RERANK=0.05
# KB_SEARCH_MIN_RERANK=0.005

# 交付件 Word 导出模板（决策记录 2026-11-10）。不写就用内置默认模板。部署后把公司模板放到部署机上，
# 在 docker-compose.override.yml 里给 backend 只读挂载（如 - /srv/templates:/srv/templates:ro），再写下面这行并重建 backend。
# 模板里可用占位符 {{项目代号}} {{服务}} {{行业}} {{交付件编号}} {{交付件名称}} {{修订}} {{导出日期}} {{状态}}，
# 单独一段写 {{正文}} 的位置放各章正文。配置了但文件不存在时导出返回 503，不会退回默认模板。
# EXPORT_TEMPLATE=/srv/templates/deliverable.docx

# 容器日志轮转（docker-compose.yml 的 x-logging）：单个文件上限和保留个数
LOG_MAX_SIZE=20m
LOG_MAX_FILE=10

# 备份（scripts/backup.sh，docs/备份与恢复.md）。保留天数同时用于删除记录里的“备份中的副本最迟清除日”，
# 不要超过合同约定的最短保留期。备份口令文件只放部署机（权限 600），路径在运行备份时用环境变量 BACKUP_PASSPHRASE_FILE 给出，不写进本文件。
BACKUP_KEEP_DAYS=30

# 监控（docs/监控.md，docker compose --profile monitoring up -d）。Grafana 管理员口令至少 12 位，不设拒绝启动；
# Grafana 只绑定 127.0.0.1:GRAFANA_PORT，经堡垒机 SSH 隧道访问。Prometheus 数据保留期默认 30 天。
# GRAFANA_ADMIN_PASSWORD=
# GRAFANA_PORT=3000
# PROMETHEUS_RETENTION=30d
