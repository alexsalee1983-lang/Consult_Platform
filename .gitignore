# 环境与密钥
.env
# .env 的任何副本（备份、临时文件）都含密钥，一律不提交；只提交占位值的 .env.example
.env.*
!.env.example
*.env
*.pem
*.key
# TLS 证书目录只提交说明
deploy/tls/*
!deploy/tls/README.md

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
backend/tests/test.db
backend/*.db

# Node
node_modules/
frontend/dist/

# 编辑器与系统
.vscode/
.idea/
.DS_Store

# 客户资料不得进入代码仓
data/
uploads/

# 本地备份目录（scripts/backup.sh 默认位置），不提交
backups/
